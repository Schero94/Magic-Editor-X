{
  "name": "magic-editor-x",
  "version": "2.2.0",
  "description": "Free, open-source block editor for Strapi 5: Editor.js custom field with Media Library uploads, custom blocks, version history, live collaboration across several servers and an optional AI assistant with your own provider.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "strapi5",
    "editor-js",
    "editorjs",
    "block-editor",
    "rich-text",
    "wysiwyg",
    "custom-field",
    "collaboration",
    "yjs",
    "version-history",
    "ai"
  ],
  "license": "MIT",
  "author": "Schero D.",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Schero94/Magic-Editor-X.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/Magic-Editor-X/issues"
  },
  "homepage": "https://schero94.github.io/Magic-Editor-X/",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./render": {
      "source": "./shared/render/index.mjs",
      "import": "./dist/render/index.mjs",
      "require": "./dist/render/index.js",
      "default": "./dist/render/index.js"
    },
    "./schema": "./schema/magic-editor-x.schema.json",
    "./types": "./types/index.d.ts"
  },
  "bin": {
    "magic-editor-x": "bin/magic-editor-x.mjs"
  },
  "files": [
    "dist",
    "schema",
    "types",
    "bin",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "strapi-plugin build && node scripts/build-server-bundle.mjs",
    "postbuild": "npm run verify:runtime",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "verify:runtime": "node scripts/verify-server-bundle.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "prepack": "npm run build",
    "docs:llms": "node scripts/build-llms-full.mjs",
    "schema": "node scripts/build-schema.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@editorjs/attaches": "^1.3.2",
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/embed": "^2.8.0",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/paragraph": "^2.11.7",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/raw": "^2.5.1",
    "@editorjs/table": "^2.4.6",
    "@editorjs/warning": "^1.4.1",
    "dompurify": "^3.4.17",
    "editorjs-indent-tune": "^1.4.4",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "marked": "^18.2.0",
    "open-graph-scraper": "^6.13.0",
    "prismjs": "^1.30.0",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/design-system": "2.2.4",
    "@strapi/icons": "2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.1",
    "@strapi/utils": "^5.61.1",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "@strapi/strapi": "^5.38.0",
    "@strapi/utils": "^5.38.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.0",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@strapi/design-system": {
      "optional": true
    },
    "@strapi/icons": {
      "optional": true
    },
    "react-intl": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "magic-editor-x",
    "displayName": "Magic Editor X",
    "description": "Advanced block-based editor with Editor.js for Strapi v5"
  }
}
